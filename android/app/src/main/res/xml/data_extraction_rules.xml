<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the logbook database stays out of Google backups and device
     transfer; it is saved with "Logbuch sichern" instead (security.md O1 a)). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="db/" />
        <!-- BLE access codes of dive computers (security.md A5, T14.3). -->
        <exclude domain="sharedpref" path="ble_access_codes.xml" />
        <exclude domain="sharedpref" path="ble_access_codes_v2.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="db/" />
        <!-- BLE access codes of dive computers (security.md A5, T14.3). -->
        <exclude domain="sharedpref" path="ble_access_codes.xml" />
        <exclude domain="sharedpref" path="ble_access_codes_v2.xml" />
    </device-transfer>
</data-extraction-rules>
